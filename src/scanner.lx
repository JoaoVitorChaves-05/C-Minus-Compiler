%option noyywrap
%option yylineno

%{
#define YY_NO_INPUT
#define YY_NEVER_INTERACTIVE 1
#define YY_NO_UNISTD_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "ast.h"
#include "parser.tab.h"
#include "tokens.h"

#define YY_USER_ACTION \
    yylloc.first_line = yylineno; \
    yylloc.last_line = yylineno; \
    yylloc.first_column = 1; \
    yylloc.last_column = yyleng;

static int comment_start_line = 1;

static void lexical_error(const char *lexeme, int line) {
    fprintf(stderr, "ERRO LEXICO: %s''\n", lexeme);
    fprintf(stderr, "LINHA: %d\n", line);
    exit(EXIT_FAILURE);
}
%}

%x COMMENT

DIGIT       [0-9]
LETTER      [a-zA-Z]
ID          {LETTER}+
NUM         {DIGIT}+
WHITESPACE  [ \t\r\n]+

%%

"/*"                { comment_start_line = yylineno; BEGIN(COMMENT); }
<COMMENT>"*/"       { BEGIN(INITIAL); }
<COMMENT>\n         { /* yylineno is updated by Flex. */ }
<COMMENT>.          { /* Ignore comment contents. */ }
<COMMENT><<EOF>>    { lexical_error("/*", comment_start_line); }

"else"              { return ELSE; }
"if"                { return IF; }
"int"               { return INT; }
"return"            { return RETURN; }
"void"              { return VOID; }
"while"             { return WHILE; }

"+"                 { return PLUS; }
"-"                 { return MINUS; }
"*"                 { return TIMES; }
"/"                 { return OVER; }
"<="                { return LE; }
"<"                 { return LT; }
">="                { return GE; }
">"                 { return GT; }
"=="                { return EQ; }
"!="                { return NEQ; }
"="                 { return ASSIGN; }
";"                 { return SEMI; }
","                 { return COMMA; }
"("                 { return LPAREN; }
")"                 { return RPAREN; }
"["                 { return LBRACK; }
"]"                 { return RBRACK; }
"{"                 { return LBRACE; }
"}"                 { return RBRACE; }

{ID}                {
                        yylval.str_val = ast_copy_string(yytext);
                        return ID;
                    }
{NUM}               {
                        yylval.int_val = atoi(yytext);
                        return NUM;
                    }
{WHITESPACE}        { /* Ignore whitespace. */ }

.                   { lexical_error(yytext, yylineno); }
<<EOF>>             {
                        yylloc.first_line = yylineno;
                        yylloc.last_line = yylineno;
                        return 0;
                    }

%%

const char *token_name(int token) {
    switch (token) {
        case 0:       return "EOF";
        case ELSE:    return "ELSE";
        case IF:      return "IF";
        case INT:     return "INT";
        case RETURN:  return "RETURN";
        case VOID:    return "VOID";
        case WHILE:   return "WHILE";
        case ID:      return "ID";
        case NUM:     return "NUM";
        case PLUS:    return "PLUS";
        case MINUS:   return "MINUS";
        case TIMES:   return "TIMES";
        case OVER:    return "OVER";
        case LT:      return "LT";
        case LE:      return "LE";
        case GT:      return "GT";
        case GE:      return "GE";
        case EQ:      return "EQ";
        case NEQ:     return "NEQ";
        case ASSIGN:  return "ASSIGN";
        case SEMI:    return "SEMI";
        case COMMA:   return "COMMA";
        case LPAREN:  return "LPAREN";
        case RPAREN:  return "RPAREN";
        case LBRACK:  return "LBRACK";
        case RBRACK:  return "RBRACK";
        case LBRACE:  return "LBRACE";
        case RBRACE:  return "RBRACE";
        default:      return "UNKNOWN";
    }
}
