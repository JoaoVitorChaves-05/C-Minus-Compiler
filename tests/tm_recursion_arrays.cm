int total;
int shared[2];

int sum(int values[], int count) {
    if (count == 0)
        return 0;
    return values[count - 1] + sum(values, count - 1);
}

int fact(int number) {
    if (number <= 1)
        return 1;
    return number * fact(number - 1);
}

int globalSum(void) {
    return shared[0] + shared[1] + total;
}

int setTotal(void) {
    total = total + 1;
    return total;
}

int combine(int first, int second) {
    return first * 10 + second;
}

void main(void) {
    int values[3];
    int result;

    values[0] = 1;
    values[1] = 2;
    values[2] = 3;
    shared[0] = 4;
    shared[1] = 5;
    total = 3;
    result = sum(values, 3);
    {
        int result;
        result = fact(4);
        output(result);
    }
    output(result);
    output(globalSum());
    output(sum(shared, 2));
    output(combine(total, setTotal()));
}
